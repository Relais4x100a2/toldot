# === Données généalogiques réelles : JAMAIS dans Git (dépôt PRIVÉ, mais règle d'or) ===
*.gw
*.gwo
*.gwb/
*.gwplus
*.ged
*.gedcom
sample_tree*
_local_testdata/
data/geneweb_bases/
# Compagnons JSON d'organisations issus de vraies bases
*.org.json
# Exceptions : fixtures synthétiques uniquement
!core/tests/fixtures/*.gw
!core/tests/fixtures/*.gwplus
!core/tests/sample_data/*.gw
!app/**/tests/fixtures/*.gw
!app/**/tests/sample_data/*.gw

# === Environnements et secrets ===
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

